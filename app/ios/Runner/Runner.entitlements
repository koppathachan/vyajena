<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Push Notifications (push design D8): the one capability beyond the
     keychain. Xcode's App Store / TestFlight export sets "production". -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the notification extension (smarter-notifications). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.purplechaamba.vyajena</string>
	</array>
</dict>
</plist>
