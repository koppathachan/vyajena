# The vyajena2 server (server-deployment design D3), installed by deploy.sh as
# /etc/systemd/system/vyajena.service. Logs: journalctl -u vyajena
[Unit]
Description=vyajena2 server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=vyajena
Group=vyajena
# --push: real wake pings through vyajena-egress.service (push design D5, D6).
ExecStart=/usr/local/bin/vyajena-server --config /etc/vyajena/config.toml --push /etc/vyajena/push.toml
Environment=RUST_LOG=info

# The database and keys: /var/lib/vyajena, the only writable path.
StateDirectory=vyajena
StateDirectoryMode=0700
UMask=0077

# Stop: SIGTERM, the server finishes the frame in progress and closes the
# database (server-runtime: Graceful stop). Crash: start again.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2

# Sandbox (server-deployment: Sandboxed service).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Loopback only: devices come through vyajena-tunnel.service (relay D5) and
# wake pings leave through vyajena-egress.service (push D5).
IPAddressAllow=localhost
IPAddressDeny=any

# Resource ceilings (change upload-limits): throttled above MemoryHigh, killed and
# restarted above MemoryMax, so a runaway server cannot take the host down.
MemoryHigh=384M
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
