# macOS
.DS_Store

# Rust
/target/
**/target/

# Throwaway spikes: never committed; deleted once their result is in design.md.
spikes/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
# app/build is a symlink to the external drive (disk hygiene); `build/` only
# matches real folders.
/app/build
.pub-cache/
.pub/
*.iml

# flutter_rust_bridge generated
**/generated/

# Environment & secrets
.env
.env.*
*.pem
*.key

# Editor / IDE
.idea/
.vscode/
*.swp

# Logs & DBs
*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local server data (server/local.toml): database and private keys.
.server-local/

# Release signing (app-release design D3): keys, certificates, profiles and
# store API keys live with the owner, outside the repo, never in git or CI.
key.properties
*.jks
*.keystore
*.p12
*.mobileprovision
*.cer
AuthKey_*.p8

# Push credentials and Firebase config live only in ~/.vyajena-push/ (push design D6, D8).
google-services.json
GoogleService-Info.plist
fcm-service-account.json
*.p8

# Store builds: signed bundles and archives never go in git.
*.ipa
*.aab
*.apk
*.xcarchive/
*.dSYM/

# Owner-only material that must stay outside the repo: relay and push
# secrets (~/.vyajena-relay/, ~/.vyajena-push/), server backups and bootstrap
# invites (~/vyajena-server-backups/). Ignored here too in case a copy lands in
# the checkout.
.vyajena-relay/
.vyajena-push/
.vyajena-release/
vyajena-server-backups/
*bootstrap-invite*.txt
